<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.Pages.DashboardPage"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,32" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Panel" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                <Label Text="Bu ayın özeti" FontSize="13" TextColor="{StaticResource AppMuted}" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="NoticeHost" Spacing="8" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Raporlar"
                    BackgroundColor="{StaticResource AppAccent}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="46"
                    Clicked="ReportsButton_Clicked" />
                <Button
                    Grid.Column="1"
                    Text="Asistan"
                    BackgroundColor="White"
                    TextColor="{StaticResource AppInk}"
                    BorderColor="{StaticResource AppLine}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="46"
                    Clicked="AssistantButton_Clicked" />
            </Grid>

            <Grid ColumnDefinitions="1.25*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource AppInk}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Toplam bakiye" FontSize="12" TextColor="#B7C7C0" />
                        <Label x:Name="TotalBalanceLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay gelir" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="ThisMonthIncomeLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppIncome}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay gider" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="ThisMonthExpenseLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppExpense}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay tasarruf" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="SavingsLabel" Text="₺0,00" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Son 6 ay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                        <Label Text="Yeşil gelir, kırmızı gider" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <GraphicsView x:Name="ChartView" HeightRequest="210" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Bu ay gider dağılımı" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                        <VerticalStackLayout x:Name="CategoryDistributionLayout" Spacing="8" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="En çok harcanan kategoriler" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                        <Label Text="Tüm zamanlar" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <VerticalStackLayout x:Name="TopCategoriesLayout" Spacing="6" />
                        <BoxView HeightRequest="1" Color="{StaticResource AppLine}" Margin="0,6" />
                        <Label Text="Geçen aya göre" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                        <Label x:Name="MonthlyChangeLabel" Text="-" TextColor="{StaticResource AppInk}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Hedefler" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                        <Label x:Name="GoalsSummaryLabel" Text="-" TextColor="{StaticResource AppInk}" />
                        <Button
                            Text="Hedeflere git"
                            BackgroundColor="{StaticResource AppAccentSoft}"
                            TextColor="{StaticResource AppAccent}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"
                            Clicked="GoalsButton_Clicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
