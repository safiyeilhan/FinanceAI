<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.Pages.FinancialGoalsPage"
    BackgroundColor="#F6F7FB">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16,24" Spacing="12">
                <Label Text="Finansal Hedefler" FontSize="24" FontAttributes="Bold" TextColor="#171717" />

                <Button x:Name="AddGoalButton" Text="Yeni Hedef Oluştur" Clicked="AddGoalButton_Clicked" BackgroundColor="#1976D2" TextColor="White" />

                <VerticalStackLayout x:Name="GoalsLayout" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
