<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinanceAI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinanceAI"
    xmlns:pages="clr-namespace:FinanceAI.Pages"
    Title="FinanceAI"
    FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#0E7C66"
    Shell.TabBarTitleColor="#0E7C66"
    Shell.TabBarUnselectedColor="#7D9188"
    Shell.BackgroundColor="#F3F6F4"
    Shell.ForegroundColor="#10231C"
    Shell.TitleColor="#10231C"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <ShellContent
            Title="Özet"
            Icon="ic_home_accent.png"
            Route="home"
            Shell.NavBarIsVisible="False"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="İşlemler"
            Icon="ic_list_accent.png"
            Route="transactions"
            Shell.NavBarIsVisible="False"
            ContentTemplate="{DataTemplate local:TransactionsPage}" />

        <ShellContent
            Title="Panel"
            Icon="ic_chart_accent.png"
            Route="dashboard"
            Shell.NavBarIsVisible="False"
            ContentTemplate="{DataTemplate pages:DashboardPage}" />

        <ShellContent
            Title="Bütçe"
            Icon="ic_wallet_accent.png"
            Route="budgets"
            Shell.NavBarIsVisible="False"
            ContentTemplate="{DataTemplate pages:BudgetsPage}" />

        <ShellContent
            Title="Hedefler"
            Icon="ic_star_accent.png"
            Route="goals"
            Shell.NavBarIsVisible="False"
            ContentTemplate="{DataTemplate pages:FinancialGoalsPage}" />
    </TabBar>

</Shell>
