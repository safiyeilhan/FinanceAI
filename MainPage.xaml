<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:h="clr-namespace:FinanceAI.Helpers"
    x:Class="FinanceAI.MainPage"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,22,24,28" Spacing="16">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Özet" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="DateLabel" FontSize="13" TextColor="{StaticResource AppMuted}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="Yenile" ImageSource="{h:AppIcon Glyph=&#xE72C;, Tint=#0E7C66}" ContentLayout="Left, 8" BackgroundColor="White" TextColor="{StaticResource AppAccent}" BorderColor="{StaticResource AppLine}" BorderWidth="1" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" Padding="16,0" Clicked="RefreshButton_Clicked" />
                    <Button Text="Raporlar" ImageSource="{h:AppIcon Glyph=&#xE9D2;, Tint=#0E7C66}" ContentLayout="Left, 8" BackgroundColor="{StaticResource AppAccentSoft}" TextColor="{StaticResource AppAccent}" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" Padding="16,0" Clicked="Reports_Clicked" />
                    <Button Text="Asistan" ImageSource="{h:AppIcon Glyph=&#xE8F2;, Tint=#10231C}" ContentLayout="Left, 8" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" Padding="16,0" Clicked="Assistant_Clicked" />
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout x:Name="NoticeHost" Spacing="8" />

            <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource AppInk}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18,16">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Toplam bakiye" FontSize="12" TextColor="#B7C7C0" />
                        <Label x:Name="TotalBalanceLabel" Text="₺0,00" FontSize="30" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="BalanceHintLabel" Text="Tüm zamanlar" FontSize="12" TextColor="#8FA79E" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="{StaticResource AppLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="Gelir" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="IncomeLabel" Text="₺0,00" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AppIncome}" />
                        <Button Text="Gelir ekle" ImageSource="{h:AppIcon Glyph=&#xE74A;, Tint=#FFFFFF}" ContentLayout="Left, 6" BackgroundColor="{StaticResource AppAccent}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="36" FontSize="13" Clicked="AddIncome_Clicked" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="White" Stroke="{StaticResource AppLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="Gider" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="ExpenseLabel" Text="₺0,00" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AppExpense}" />
                        <Button Text="Gider ekle" ImageSource="{h:AppIcon Glyph=&#xE74B;, Tint=#D14343}" ContentLayout="Left, 6" BackgroundColor="White" TextColor="{StaticResource AppExpense}" BorderColor="#F0D4D4" BorderWidth="1" FontAttributes="Bold" CornerRadius="10" HeightRequest="36" FontSize="13" Clicked="AddExpense_Clicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Son işlemler" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppInk}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Tüm tablo" ImageSource="{h:AppIcon Glyph=&#xE8FD;, Tint=#0E7C66}" ContentLayout="Left, 6" BackgroundColor="Transparent" TextColor="{StaticResource AppAccent}" FontAttributes="Bold" FontSize="14" CornerRadius="12" HeightRequest="36" Padding="10,0" Clicked="AllTransactions_Clicked" />
            </Grid>

            <VerticalStackLayout x:Name="TransactionsLayout" Spacing="0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
