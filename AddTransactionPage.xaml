<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.AddTransactionPage"
    BackgroundColor="#F6F7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,45,24,30"
            Spacing="20">

            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Grid.Column="0"
                    Text="‹"
                    FontSize="32"
                    BackgroundColor="Transparent"
                    TextColor="#171717"
                    WidthRequest="45"
                    HeightRequest="45"
                    Padding="0"
                    Clicked="BackButton_Clicked" />

                <Label
                    Grid.Column="1"
                    Text="Yeni İşlem"
                    FontSize="27"
                    FontAttributes="Bold"
                    TextColor="#171717"
                    VerticalOptions="Center" />

            </Grid>

            <!-- INCOME / EXPENSE -->
            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Padding="6">

                <Grid ColumnDefinitions="*,*">

                    <Button
                        x:Name="IncomeButton"
                        Grid.Column="0"
                        Text="Gelir"
                        BackgroundColor="#171717"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="48"
                        Clicked="IncomeButton_Clicked" />

                    <Button
                        x:Name="ExpenseButton"
                        Grid.Column="1"
                        Text="Gider"
                        BackgroundColor="White"
                        TextColor="#171717"
                        CornerRadius="14"
                        HeightRequest="48"
                        Clicked="ExpenseButton_Clicked" />

                </Grid>

            </Border>

            <!-- AMOUNT -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Tutar"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#444444" />

                <Border
                    BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#E5E5E5"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,0">

                    <Grid ColumnDefinitions="Auto,*">

                        <Label
                            Text="₺"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalOptions="Center" />

                        <Entry
                            x:Name="AmountEntry"
                            Grid.Column="1"
                            Placeholder="0,00"
                            Keyboard="Numeric"
                            FontSize="24"
                            TextColor="#171717"
                            PlaceholderColor="#AAAAAA"
                            BackgroundColor="Transparent" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

            <!-- CATEGORY -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Kategori"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#444444" />

                <Border
                    BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#E5E5E5"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,0">

                    <Picker
                        x:Name="CategoryPicker"
                        Title="Kategori seçin"
                        FontSize="16"
                        TextColor="#171717">

                        <Picker.Items>
                            <x:String>Maaş</x:String>
                            <x:String>Alışveriş</x:String>
                            <x:String>Yemek</x:String>
                            <x:String>Ulaşım</x:String>
                            <x:String>Eğitim</x:String>
                            <x:String>Fatura</x:String>
                            <x:String>Abonelik</x:String>
                            <x:String>Sağlık</x:String>
                            <x:String>Diğer</x:String>
                        </Picker.Items>

                    </Picker>

                </Border>

            </VerticalStackLayout>

            <!-- DESCRIPTION -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Açıklama"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#444444" />

                <Border
                    BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#E5E5E5"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">

                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Örneğin: Market alışverişi"
                        PlaceholderColor="#AAAAAA"
                        TextColor="#171717"
                        FontSize="15"
                        HeightRequest="100"
                        AutoSize="TextChanges" />

                </Border>

            </VerticalStackLayout>

            <!-- SAVE -->
            <Button
                Text="İşlemi Kaydet"
                BackgroundColor="#171717"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="56"
                Margin="0,10,0,0"
                Clicked="SaveButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>