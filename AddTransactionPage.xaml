<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:h="clr-namespace:FinanceAI.Helpers"
    x:Class="FinanceAI.AddTransactionPage"
    Title="Yeni işlem"
    BackgroundColor="{StaticResource AppBackground}"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="#F3F6F4"
    Shell.TitleColor="#10231C"
    Shell.ForegroundColor="#10231C"
    Shell.NavBarHasShadow="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="18">

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Padding="6">
                <Grid ColumnDefinitions="*,*">
                    <Button
                        x:Name="IncomeButton"
                        Grid.Column="0"
                        Text="Gelir"
                        ImageSource="{h:AppIcon Glyph=&#xE74A;, Tint=#FFFFFF}"
                        ContentLayout="Left, 8"
                        BackgroundColor="{StaticResource AppAccent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Clicked="IncomeButton_Clicked" />
                    <Button
                        x:Name="ExpenseButton"
                        Grid.Column="1"
                        Text="Gider"
                        ImageSource="{h:AppIcon Glyph=&#xE74B;, Tint=#10231C}"
                        ContentLayout="Left, 8"
                        BackgroundColor="White"
                        TextColor="{StaticResource AppInk}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Clicked="ExpenseButton_Clicked" />
                </Grid>
            </Border>

            <Label
                x:Name="TypeHintLabel"
                Text="Gelir bakiyeyi artırır."
                FontSize="13"
                TextColor="{StaticResource AppMuted}" />

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                FontSize="13"
                TextColor="{StaticResource AppExpense}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Tutar" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,4">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            Text="₺"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AppInk}"
                            VerticalOptions="Center" />
                        <Entry
                            x:Name="AmountEntry"
                            Grid.Column="1"
                            Placeholder="0,00"
                            Keyboard="Numeric"
                            FontSize="26"
                            TextColor="{StaticResource AppInk}"
                            PlaceholderColor="#A3B5AE"
                            BackgroundColor="Transparent" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Kategori" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,0">
                    <Picker
                        x:Name="CategoryPicker"
                        Title="Kategori seç"
                        FontSize="16"
                        TextColor="{StaticResource AppInk}"
                        TitleColor="{StaticResource AppMuted}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Tarih" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="12,0">
                    <DatePicker
                        x:Name="DatePicker"
                        Format="dd MMMM yyyy"
                        FontSize="16"
                        TextColor="{StaticResource AppInk}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Açıklama" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,8">
                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="İsteğe bağlı not"
                        PlaceholderColor="#A3B5AE"
                        TextColor="{StaticResource AppInk}"
                        FontSize="15"
                        HeightRequest="90"
                        AutoSize="Disabled"
                        BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Button
                x:Name="SaveButton"
                Text="Kaydet"
                ImageSource="{h:AppIcon Glyph=&#xE74E;, Tint=#FFFFFF}"
                ContentLayout="Left, 8"
                BackgroundColor="{StaticResource AppInk}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="54"
                Clicked="SaveButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
