<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceAI.Pages.BudgetsPage"
             BackgroundColor="#F6F7FB">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16,20" Spacing="12">
                <Label Text="Bütçeler" FontSize="24" FontAttributes="Bold" />

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Özet" FontAttributes="Bold" />
                        <Label x:Name="BudgetsSummaryLabel" Text="-" />
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="AddBudgetButton" Text="Yeni Bütçe Ekle" BackgroundColor="#1976D2" TextColor="White" CornerRadius="8" HeightRequest="44" />

                <StackLayout x:Name="BudgetsListLayout" Spacing="10" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
