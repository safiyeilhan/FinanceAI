<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.Pages.FinancialAssistantPage"
    Title="Asistan"
    BackgroundColor="{StaticResource AppBackground}"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="#F3F6F4"
    Shell.TitleColor="#10231C"
    Shell.ForegroundColor="#10231C"
    Shell.NavBarHasShadow="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14">

            <Border BackgroundColor="{StaticResource AppInk}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="SummaryLabel" Text="Yükleniyor..." TextColor="White" FontSize="15" />
                    <Label x:Name="HighCategoryLabel" Text="-" TextColor="#B7C7C0" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay gelir" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="TotalIncomeLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppIncome}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay gider" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="TotalExpenseLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppExpense}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bu ay kalan" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="BalanceLabel" Text="₺0,00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tasarruf oranı" FontSize="12" TextColor="{StaticResource AppMuted}" />
                        <Label x:Name="SavingsRateLabel" Text="%0" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Yorum" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="InsightsLabel" Text="Yükleniyor..." TextColor="{StaticResource AppInk}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bütçeler" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="BudgetsSummaryLabel" Text="Yükleniyor..." TextColor="{StaticResource AppMuted}" />
                    <VerticalStackLayout x:Name="BudgetsListLayout" Spacing="8" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Hızlı sorular" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />

            <Button Text="Bu ay param nereye gitti?" Clicked="WhereDidMyMoneyGo_Clicked" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" CornerRadius="14" HeightRequest="48" />
            <Button Text="En çok neye harcıyorum?" Clicked="WhatDoISpendMostOn_Clicked" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" CornerRadius="14" HeightRequest="48" />
            <Button Text="Bu ay ne kadar tasarruf ettim?" Clicked="HowMuchSavedThisMonth_Clicked" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" CornerRadius="14" HeightRequest="48" />
            <Button Text="Geçen aya göre durumum nasıl?" Clicked="CompareToLastMonth_Clicked" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" CornerRadius="14" HeightRequest="48" />

            <Border BackgroundColor="{StaticResource AppAccentSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <Label x:Name="QuickAnswerLabel" Text="Bir soru seç, yanıt burada görünsün." TextColor="{StaticResource AppInk}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
