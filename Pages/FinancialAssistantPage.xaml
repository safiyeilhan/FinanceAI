<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.Pages.FinancialAssistantPage"
    BackgroundColor="#F6F7FB">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16,24" Spacing="12">

                <Label Text="Finansal Asistan" FontSize="24" FontAttributes="Bold" TextColor="#171717" />

                <!-- Short summary -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="SummaryLabel" Text="Yükleniyor..." />
                        <Label x:Name="HighCategoryLabel" Text="-" />
                    </VerticalStackLayout>
                </Border>

                <!-- Metrics -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Toplam Gelir" FontSize="12" TextColor="#666666" />
                            <Label x:Name="TotalIncomeLabel" Text="₺0.00" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Toplam Gider" FontSize="12" TextColor="#666666" />
                            <Label x:Name="TotalExpenseLabel" Text="₺0.00" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Bakiye" FontSize="12" TextColor="#666666" />
                            <Label x:Name="BalanceLabel" Text="₺0.00" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Tasarruf Oranı" FontSize="12" TextColor="#666666" />
                            <Label x:Name="SavingsRateLabel" Text="0%" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Insights -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Finansal İçgörüler" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="InsightsLabel" Text="Yükleniyor..." />
                    </VerticalStackLayout>
                </Border>

                <!-- Budget summaries -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Bütçe Özetleri" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="BudgetsSummaryLabel" Text="Yükleniyor..." />
                        <StackLayout x:Name="BudgetsListLayout" Spacing="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick question buttons -->
                <VerticalStackLayout Spacing="8">
                    <Button Text="Bu ay param nereye gitti?" Clicked="WhereDidMyMoneyGo_Clicked" BackgroundColor="#1976D2" TextColor="White" />
                    <Button Text="En çok neye harcıyorum?" Clicked="WhatDoISpendMostOn_Clicked" BackgroundColor="#1976D2" TextColor="White" />
                    <Button Text="Bu ay ne kadar tasarruf ettim?" Clicked="HowMuchSavedThisMonth_Clicked" BackgroundColor="#1976D2" TextColor="White" />
                    <Button Text="Geçen aya göre durumum nasıl?" Clicked="CompareToLastMonth_Clicked" BackgroundColor="#1976D2" TextColor="White" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <Label x:Name="QuickAnswerLabel" Text="" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
