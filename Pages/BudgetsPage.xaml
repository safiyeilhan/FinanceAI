<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:FinanceAI.Helpers"
             x:Class="FinanceAI.Pages.BudgetsPage"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,22,24,28" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Bütçeler" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="BudgetsSummaryLabel" Text="Aylık harcama limiti" FontSize="13" TextColor="{StaticResource AppMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Yenile" ImageSource="{h:AppIcon Glyph=&#xE72C;, Tint=#0E7C66}" ContentLayout="Left, 8" BackgroundColor="White" TextColor="{StaticResource AppAccent}" BorderColor="{StaticResource AppLine}" BorderWidth="1" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" Padding="16,0" VerticalOptions="Center" Clicked="RefreshButton_Clicked" />
            </Grid>

            <Border BackgroundColor="White" Stroke="{StaticResource AppLine}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="FormTitleLabel" Text="Yeni bütçe" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="FormErrorLabel" IsVisible="False" FontSize="13" TextColor="{StaticResource AppExpense}" />
                    <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0">
                            <Picker x:Name="CategoryPicker" Title="Kategori" TextColor="{StaticResource AppInk}" TitleColor="{StaticResource AppMuted}" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0">
                            <Entry x:Name="CustomCategoryEntry" Placeholder="veya yeni ad" PlaceholderColor="#A3B5AE" TextColor="{StaticResource AppInk}" BackgroundColor="Transparent" />
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0">
                            <Entry x:Name="LimitEntry" Placeholder="Aylık limit" Keyboard="Numeric" PlaceholderColor="#A3B5AE" TextColor="{StaticResource AppInk}" BackgroundColor="Transparent" />
                        </Border>
                        <Button x:Name="AddBudgetButton" Grid.Column="3" Text="Ekle" ImageSource="{h:AppIcon Glyph=&#xE710;, Tint=#FFFFFF}" ContentLayout="Left, 6" BackgroundColor="{StaticResource AppAccent}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" Padding="14,0" Clicked="AddBudgetButton_Clicked" />
                        <Button x:Name="CancelBudgetButton" Grid.Column="4" Text="Vazgeç" ImageSource="{h:AppIcon Glyph=&#xE711;, Tint=#10231C}" ContentLayout="Left, 6" IsVisible="False" BackgroundColor="White" TextColor="{StaticResource AppInk}" BorderColor="{StaticResource AppLine}" BorderWidth="1" CornerRadius="12" HeightRequest="44" Padding="14,0" Clicked="CancelBudgetButton_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="BudgetsListLayout" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
