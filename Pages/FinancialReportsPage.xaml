<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:h="clr-namespace:FinanceAI.Helpers"
    x:Class="FinanceAI.Pages.FinancialReportsPage"
    Title="Raporlar"
    BackgroundColor="{StaticResource AppBackground}"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="#F3F6F4"
    Shell.TitleColor="#10231C"
    Shell.ForegroundColor="#10231C"
    Shell.NavBarHasShadow="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12,0">
                    <Picker x:Name="PeriodPicker" Title="Dönem seç" TextColor="{StaticResource AppInk}" TitleColor="{StaticResource AppMuted}">
                        <Picker.Items>
                            <x:String>Bu ay</x:String>
                            <x:String>Geçen ay</x:String>
                            <x:String>Son 3 ay</x:String>
                            <x:String>Son 6 ay</x:String>
                            <x:String>Bu yıl</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
                <Button Grid.Column="1" Text="Yenile" ImageSource="{h:AppIcon Glyph=&#xE72C;, Tint=#0E7C66}" ContentLayout="Left, 8" BackgroundColor="White" TextColor="{StaticResource AppAccent}" BorderColor="{StaticResource AppLine}" BorderWidth="1" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" Padding="16,0" VerticalOptions="Center" Clicked="RefreshButton_Clicked" />
            </Grid>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Özet" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="TotalIncomeLabel" Text="Gelir: ₺0,00" TextColor="{StaticResource AppIncome}" />
                    <Label x:Name="TotalExpenseLabel" Text="Gider: ₺0,00" TextColor="{StaticResource AppExpense}" />
                    <Label x:Name="NetChangeLabel" Text="Net: ₺0,00" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="SavingsRateLabel" Text="Tasarruf oranı: %0" TextColor="{StaticResource AppMuted}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gider dağılımı" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <GraphicsView x:Name="CategoryPieView" HeightRequest="180" />
                    <VerticalStackLayout x:Name="CategoryListLayout" Spacing="6" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Aylık gelir ve gider" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label Text="Yeşil gelir, kırmızı gider" FontSize="12" TextColor="{StaticResource AppMuted}" />
                    <GraphicsView x:Name="IncomeExpenseView" HeightRequest="200" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="En yüksek 3 gider" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <VerticalStackLayout x:Name="TopCategoriesLayout" Spacing="6" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Notlar" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource AppInk}" />
                    <Label x:Name="InsightsLabel" Text="-" TextColor="{StaticResource AppInk}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
