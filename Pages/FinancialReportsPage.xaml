<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinanceAI.Pages.FinancialReportsPage"
    BackgroundColor="#F6F7FB">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16,24" Spacing="12">

                <Label Text="Finansal Raporlar" FontSize="24" FontAttributes="Bold" TextColor="#171717" />

                <Picker x:Name="PeriodPicker" Title="Dönem seçin">
                    <Picker.Items>
                        <x:String>Bu ay</x:String>
                        <x:String>Geçen ay</x:String>
                        <x:String>Son 3 ay</x:String>
                        <x:String>Son 6 ay</x:String>
                        <x:String>Bu yıl</x:String>
                    </Picker.Items>
                </Picker>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Gelir / Gider Özeti" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="TotalIncomeLabel" Text="Toplam Gelir: ₺0" />
                        <Label x:Name="TotalExpenseLabel" Text="Toplam Gider: ₺0" />
                        <Label x:Name="NetChangeLabel" Text="Net Değişim: ₺0" />
                        <Label x:Name="SavingsRateLabel" Text="Tasarruf Oranı: 0%" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Kategori Bazlı Gider Dağılımı" FontSize="14" FontAttributes="Bold" />
                        <GraphicsView x:Name="CategoryPieView" HeightRequest="220" />
                        <StackLayout x:Name="CategoryListLayout" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Gelir vs Gider (Zaman serisi)" FontSize="14" FontAttributes="Bold" />
                        <GraphicsView x:Name="IncomeExpenseView" HeightRequest="220" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aylık Trend (Son 6 Ay)" FontSize="14" FontAttributes="Bold" />
                        <GraphicsView x:Name="TrendView" HeightRequest="180" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="En Çok Harcama Yapılan 3 Kategori" FontSize="14" FontAttributes="Bold" />
                        <StackLayout x:Name="TopCategoriesLayoutReports" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Finansal İçgörüler" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="InsightsLabelReports" Text="-" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
